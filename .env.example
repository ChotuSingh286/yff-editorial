# PostgreSQL connection string used by the app and Drizzle Kit.
# Local default: postgresql://postgres:postgres@127.0.0.1:5432/app_db
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign sign-in sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=replace-this-with-a-random-secret-at-least-32-characters-long

# Private upload directory for article files. Keep it outside public/.
# On Vercel this is replaced by a cloud-storage adapter (see DEPLOYMENT.md).
UPLOAD_DIR=./data/uploads

# Optional seed password overrides (defaults shown in README.md)
ADMIN_PASSWORD=YFFAdmin!2026
SECOND_ADMIN_PASSWORD=YFFEditor!2026
WRITER_PASSWORD=YFFWriter!2026
